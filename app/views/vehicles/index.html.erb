<% content_for(:title, t('.title')) %>
<div class="container pt-3">
  <div class="row">
    <div class="col-lg-12">
      <div class="d-flex justify-content-between align-items-center mb-4">  
        <h2 class="mb-0">車両一覧</h2>
        <%= link_to '＋ 車両を登録', new_vehicle_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
  
  <!-- 車両タイプバッジ（オプション） -->
  <div class="mt-4 mb-3">
    <h5>
      <span class="badge text-bg-primary me-1">ガソリン車</span>
      <span class="badge text-bg-success me-1">ハイブリッド車</span>
    </h5>
  </div>
  
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @vehicles.present? %>
          <%= render @vehicles %>
        <% else %>
          <div class="text-center py-5">
            <div class="mb-3">
              <i class="bi bi-car-front" style="font-size: 4rem; color: #6c757d;"></i>
            </div>
            <h5 class="text-muted mb-2">車両がまだ登録されていません</h5>
            <p class="text-muted small">最初の車両を登録してみましょう</p>
          </div>
        <% end %>
        <%= paginate @vehicles, theme: 'bootstrap-5', param_name: :vehicles_page %>
      </div>
    </div>
  </div>
</div>