<% content_for(:title, t('.title')) %>
<div class="container">
  <div class="row">
    <div class="col-lg-12 mt-4">
      <%= link_to '車両一覧', vehicles_path, class: "link" %> / <%= @vehicle.vehicle_name %>
      
      <article class="card mt-3">
        <div class="card-body">
          <div class="row">
            <!-- 左側：車両情報とオイル交換情報 -->
            <div class="col-md-8">
              <h3><%= @vehicle.vehicle_name %></h3>
              
              <div class="text-muted mt-2">
                <i class="bi bi-car-front"></i> <%= @vehicle.manufacturer.name %> / <%= @vehicle.model %>
              </div>

              <!-- 車両タイプバッジ -->
              <div class="mt-3">
                <% if @vehicle.vehicle_type == 'normal' %>
                  <span class="badge text-bg-primary">ガソリン車</span>
                <% elsif @vehicle.vehicle_type == 'hybrid' %>
                  <span class="badge text-bg-success">ハイブリッド車</span>
                <% end %>
              </div>

              <!-- オイル交換情報 -->
              <div class="mt-4">
                <h5>次回オイル交換の目安</h5>
                <% if @vehicle.last_oil_change %>
                  <div class="alert alert-info">
                    <ul class="mb-0">
                      <li>
                        <strong>走行距離ベース:</strong> 
                        <% if @vehicle.km_until_next_oil_change > 0 %>
                          あと<%= number_with_delimiter(@vehicle.km_until_next_oil_change) %>km
                        <% else %>
                          <span class="text-danger">
                            <%= number_with_delimiter(@vehicle.km_until_next_oil_change.abs) %>km超過
                          </span>
                        <% end %>
                      </li>
                      <li>
                        <strong>期間ベース:</strong> 
                        <% if @vehicle.days_until_next_oil_change > 0 %>
                          あと<%= @vehicle.days_until_next_oil_change %>日
                        <% else %>
                          <span class="text-danger">
                            <%= @vehicle.days_until_next_oil_change.abs %>日超過
                          </span>
                        <% end %>
                      </li>
                    </ul>
                    
                    <!-- 警告表示 -->
                    <% if @vehicle.needs_oil_change_soon? %>
                      <div class="alert alert-danger mt-2 mb-0">
                        <strong>⚠️ オイル交換の時期が近づいています!</strong>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <p class="text-muted">オイル交換履歴を登録してください</p>
                <% end %>
              </div>

              <!-- 車両詳細情報 -->
              <div class="mt-4">
                <h5>車両詳細</h5>
                <dl class="row">
                  <dt class="col-sm-4">年式:</dt>
                  <dd class="col-sm-8"><%= @vehicle.year %>年</dd>

                  <dt class="col-sm-4">現在の走行距離:</dt>
                  <dd class="col-sm-8"><%= number_with_delimiter(@vehicle.current_mileage) %> km</dd>
                </dl>
              </div>

            </div>

            <!-- 右側：登録情報と編集・削除ボタン -->
            <div class="col-md-4">
              <div class="bg-light rounded p-3">
                <table class="table table-sm table-borderless mb-0">
                  <tbody>
                    <tr>
                      <th class="text-muted">登録日</th>
                      <td><%= @vehicle.created_at.strftime("%Y-%m-%d") %></td>
                    </tr>
                    <tr>
                      <th class="text-muted">登録者</th>
                      <td><%= @vehicle.user.name %></td>
                    </tr>
                    <tr>
                      <th class="text-muted">オイル交換回数</th>
                      <td><%= @vehicle.oil_change_records.size %>件</td>
                    </tr>
                  </tbody>
                </table>
                <hr>

                <!-- 編集・削除ボタン -->
                <% if current_user.own?(@vehicle) %>
                  <div class="d-grid gap-2">
                    <%= link_to edit_vehicle_path(@vehicle), class: "btn btn-outline-primary btn-sm" do %>
                      <i class="bi bi-pencil"></i> 編集
                    <% end %>
                    <%= link_to vehicle_path(@vehicle), class: "btn btn-outline-danger btn-sm", data: { turbo_method: :delete, turbo_confirm: '削除しますか？' } do %>
                      <i class="bi bi-trash-fill"></i> 削除
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

          </div>
        </div>
      </article>
    </div>
  </div>

  <!-- オイル交換履歴一覧 -->
  <div class="col-lg-12 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">  
      <h4 class="mb-0">オイル交換履歴（<%= @oil_change_records.total_count %>件）</h4>
      <%= link_to new_vehicle_oil_change_record_path(@vehicle), class: "btn btn-success" do %>
        <i class="bi bi-plus-circle"></i> オイル交換記録を追加
      <% end %>
    </div>
  </div>

   <div class="row">
    <% if @oil_change_records.present? %>
      <%= render @oil_change_records %>
    <% else %>
      <div class="col-12">
        <div class="alert alert-secondary">
          オイル交換履歴がまだありません
        </div>
      </div>
    <% end %>
    <%= paginate @oil_change_records, theme: 'bootstrap-5', param_name: :oil_change_records_page %>
  </div>
</div>