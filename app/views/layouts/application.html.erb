<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- OGP設定 -->
    <meta property="og:title" content="MechaniCare" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= request.original_url %>" />
    <meta property="og:image" content="<%= image_url('ogp.png') %>" />
    <meta property="og:description" content="愛車のメンテナンス記録を簡単に管理できるアプリです。オイル交換の記録やリマインダー機能で、大切な愛車を守ります。" />
    <meta property="og:site_name" content="MechaniCare" />

    <!-- Twitter Card設定 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="MechaniCare" />
    <meta name="twitter:description" content="愛車のメンテナンス記録を簡単に管理できるアプリです。オイル交換の記録やリマインダー機能で、大切な愛車を守ります。" />
    <meta name="twitter:image" content="<%= image_url('ogp.png') %>" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    
    <!-- Bootstrap Icons（これを追加！） -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  </head>

  <!-- フッターを下に固定するためにこれしてる -->
  <body style="display: flex; flex-direction: column; min-height: 100vh;">
    <% if user_signed_in? %>
      <%= render 'shared/header' %>
    <% else %>
      <%= render 'shared/before_login_header' %>
    <% end %>

    <!-- フラッシュメッセージを表示 -->
    <div class="container mt-3">
      <%= render 'shared/flash_message' %>
    </div>

    <div class="container mt-4" style="flex: 1;">
      <%= yield %>
    </div>

    <%= render 'shared/footer' %>
  </body>
</html>
