<% content_for(:title, t('.title')) %>
<div class="container">
  <div class="row">
    <div class="col-lg-12 mt-4">
      <%= link_to '車両一覧', vehicles_path, class: "link" %> / 
      <%= link_to @vehicle.vehicle_name, vehicle_path(@vehicle), class: "link" %> / 
      オイル交換記録を編集
      
      <article class="card mt-3">
        <div class="card-body">
          <h3>オイル交換記録を編集</h3>
          
          <%= form_with model: @oil_change_record, url: vehicle_oil_change_record_path(@vehicle, @oil_change_record), local: true do |f| %>
            
            <!-- エラーメッセージ -->
            <%= render 'shared/error_messages', object: f.object %>

            <!-- 交換日 -->
            <div class="mb-3">
              <%= f.label :changed_at, '交換日', class: "form-label" %>
              <%= f.date_field :changed_at, class: "form-control" %>
            </div>

            <!-- 走行距離 -->
            <div class="mb-3">
              <%= f.label :mileage, '走行距離', class: "form-label" %>
              <%= f.number_field :mileage, class: "form-control", placeholder: "例: 50000" %>
            </div>

            <!-- メモ -->
            <div class="mb-3">
              <%= f.label :memo, 'メモ', class: "form-label" %>
              <%= f.text_area :memo, class: "form-control", rows: 4, placeholder: "例: オイルエレメントも同時交換" %>
            </div>

            <hr>

            <!-- ボタン -->
            <div class="d-flex gap-2">
              <%= f.submit '✓更新する', class: "btn btn-primary" %>
              <%= link_to '車両詳細に戻る', vehicle_path(@vehicle), class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </article>
    </div>
  </div>
</div>