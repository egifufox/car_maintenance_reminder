<div class="col-md-6 mb-3">
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">
        <i class="bi bi-droplet-fill text-warning"></i> 
        <%= oil_change_record.changed_at.strftime("%Y年%m月%d日") %>
      </h5>
      <p class="card-text">
        <strong>走行距離:</strong> <%= number_with_delimiter(oil_change_record.mileage) %> km<br>
        <% if oil_change_record.memo.present? %>
          <strong>メモ:</strong> <%= simple_format(oil_change_record.memo) %>
        <% end %>
      </p>
      <div class="d-flex gap-2">
        <%= link_to edit_vehicle_oil_change_record_path(@vehicle, oil_change_record), class: "btn btn-sm btn-outline-primary" do %>
          <i class="bi bi-pencil"></i> 編集
        <% end %>
        <%= link_to vehicle_oil_change_record_path(@vehicle, oil_change_record), class: "btn btn-sm btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: '削除しますか？' } do %>
          <i class="bi bi-trash-fill"></i> 削除
        <% end %>
      </div>
    </div>
  </div>
</div>