<% content_for(:title, t('.title')) %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class=" col-md-5 col-lg-3">
      <div class="card">
        <div class="card-body"> 
          <h1 class="card-title text-center">ログイン</h1>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.label :email, 'メールアドレス' %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "user@example.com" %>
            </div>
            <%# autofocus: true, autocomplete: "email"で自動入力させることでUI向上させてる　%>

            <div class="mb-3">
                 <%= f.label :password, 'パスワード' %>
                 <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "パスワード" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="form-check mb-3">
                <%= f.check_box :remember_me, class: "form-check-input", id: "remember_me" %>
                <%= f.label :remember_me, 'ログイン状態を保持する', class: "form-check-label", for: "remember_me" %>
              </div>
            <% end %>

            <div class="d-grid">
              <%= f.submit "ログイン", class: "btn btn-primary" %>
            </div>
          <% end %>
 
          <div class='text-center mt-1'>
            <%= link_to 'アカウントをお持ちでない方はこちら', new_user_registration_path, class: "link" %>
          </div>                
        </div>
      </div>
    </div>
  </div>
</div>