<% content_for(:title, t('.title')) %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-3">
      <div class="card">
        <div class="card-body"> 
          <h1 class="card-title text-center">ログイン</h1>

          <!-- Google ログインボタン -->
          <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false }, class: 'btn btn-outline-dark w-100 mt-1 mb-3' do %>
            <i class="bi bi-google"></i> Googleでログイン
          <% end %>

          <!-- 区切り線 -->
          <div class="d-flex align-items-center mb-1">
            <hr class="flex-grow-1">
            <span class="mx-3 text-muted">または</span>
            <hr class="flex-grow-1">
          </div>

          <!-- メールアドレスでログイン -->
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.label :email, 'メールアドレス' %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control mt-1", placeholder: "user@example.com" %>
            </div>
            <%# autofocus: true, autocomplete: "email"で自動入力させることでUI向上させてる　%>

            <div class="mb-3">
              <%= f.label :password, 'パスワード' %>
              <div class="input-group mt-1">
                <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "パスワード", id: "password-field" %>
                <button class="btn btn-outline-secondary" type="button" id="toggle-password">
                  <i class="bi bi-eye" id="toggle-password-icon"></i>
                </button>
              </div>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="form-check mb-3">
                <%= f.check_box :remember_me, class: "form-check-input", id: "remember_me" %>
                <%= f.label :remember_me, 'ログイン状態を保持する', class: "form-check-label", for: "remember_me" %>
              </div>
            <% end %>

            <div class="d-grid">
              <%= f.submit "ログイン", class: "btn btn-primary" %>
            </div>
          <% end %>
 
          <div class='text-center mt-3'>
            <%= link_to 'アカウントをお持ちでない方はこちら', new_user_registration_path, class: "link" %>
          </div>                

          <div class='text-center mt-3'>
            <%= link_to 'パスワードをお忘れの方はこちら', new_user_password_path, class: "link" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>